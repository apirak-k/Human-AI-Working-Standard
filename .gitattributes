# Auto detect text files and enforce LF normalization
* text=auto eol=lf

# Explicit LF enforcement across languages and docs
*.sh text eol=lf
*.bash text eol=lf
*.ps1 text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.py text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.jsx text eol=lf
*.html text eol=lf
*.css text eol=lf

# Windows batch files (must remain CRLF for cmd.exe compatibility)
*.cmd text eol=crlf
*.bat text eol=crlf